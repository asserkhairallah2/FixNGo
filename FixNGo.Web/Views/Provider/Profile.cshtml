@model ProviderProfileDto
@{
    ViewData["Title"] = "Provider Profile - FixNGo";
}

<!-- Flash Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-4 pb-2 border-bottom">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small">
            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-secondary text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active text-body" aria-current="page">Provider Profile</li>
        </ol>
    </nav>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h2 class="fw-bold mb-1">Provider Profile & Credentials</h2>
            <p class="text-secondary mb-0">Manage your verified operational details, primary service category, and contact information.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            @if (Model.VerificationStatus == VerificationStatus.Verified)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6">
                    <i class="bi bi-patch-check-fill me-1"></i>Verified Provider
                </span>
            }
            else
            {
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 fs-6">
                    <i class="bi bi-clock-history me-1"></i>Status: @Model.VerificationStatus
                </span>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Overview & Performance -->
    <div class="col-lg-4">
        <!-- Profile Identity Card -->
        <div class="card border bg-body-tertiary rounded-4 shadow-sm p-4 text-center mb-4">
            <div class="mb-3">
                <span class="p-4 rounded-circle bg-warning bg-opacity-10 d-inline-block">
                    <i class="bi bi-person-gear fs-1 text-warning"></i>
                </span>
            </div>
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <span class="badge bg-secondary-subtle text-body border px-2 py-1 mb-3">@Model.PrimaryServiceType Specialist</span>
            <p class="text-secondary small mb-3">@Model.Bio</p>

            <div class="d-flex justify-content-around py-3 border-top border-bottom mb-3">
                <div>
                    <span class="d-block fw-bold fs-5 text-warning">@Model.Rating.ToString("F1") <i class="bi bi-star-fill small"></i></span>
                    <small class="text-secondary">@Model.TotalReviews Reviews</small>
                </div>
                <div class="vr"></div>
                <div>
                    <span class="d-block fw-bold fs-5 text-success">@Model.CompletedJobsCount</span>
                    <small class="text-secondary">Completed</small>
                </div>
            </div>

            <!-- Availability Toggle -->
            <form asp-action="ToggleAvailability" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="/Provider/Profile" />
                <button type="submit" class="btn @(Model.IsOnline ? "btn-outline-danger" : "btn-success") w-100 py-2 fw-bold">
                    <i class="bi bi-power me-1"></i> @(Model.IsOnline ? "Switch to Offline" : "Switch to Online")
                </button>
            </form>
        </div>

        <!-- Verification Compliance Box -->
        <div class="card border bg-body-tertiary rounded-4 shadow-sm p-4">
            <h6 class="fw-bold mb-3"><i class="bi bi-shield-check text-success me-2"></i>Verification Compliance</h6>
            <ul class="list-unstyled small text-secondary mb-0 d-flex flex-column gap-2">
                <li class="d-flex align-items-center justify-content-between">
                    <span>Identity Status:</span>
                    <strong class="@(Model.VerificationStatus == VerificationStatus.Verified ? "text-success" : "text-warning")">@Model.VerificationStatus</strong>
                </li>
                <li class="d-flex align-items-center justify-content-between">
                    <span>National ID on file:</span>
                    <strong class="text-body">@(string.IsNullOrEmpty(Model.NationalId) ? "Pending Submission" : "Verified")</strong>
                </li>
                <li class="d-flex align-items-center justify-content-between">
                    <span>Driving License:</span>
                    <strong class="text-body">@(string.IsNullOrEmpty(Model.DriverLicenseNumber) ? "Pending Submission" : "Verified")</strong>
                </li>
            </ul>
        </div>
    </div>

    <!-- Right Column: Profile Edit Form -->
    <div class="col-lg-8">
        <div class="card border bg-body-tertiary rounded-4 shadow-sm p-4">
            <h5 class="fw-bold mb-4"><i class="bi bi-pencil-square text-warning me-2"></i>Update Operational Profile</h5>

            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()

                <!-- Section: Personal Info -->
                <h6 class="text-secondary small fw-bold text-uppercase mb-3">1. Personal & Contact Information</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label for="fullName" class="form-label fw-semibold small">Full Name</label>
                        <input type="text" name="FullName" id="fullName" class="form-control" value="@Model.FullName" required />
                    </div>
                    <div class="col-md-6">
                        <label for="phone" class="form-label fw-semibold small">Contact Mobile Number</label>
                        <input type="tel" name="Phone" id="phone" class="form-control" value="@Model.Phone" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Account Email (Verified)</label>
                        <input type="email" class="form-control bg-dark bg-opacity-25" value="@Model.Email" readonly disabled />
                        <div class="form-text small">Email address is managed by platform security and cannot be changed here.</div>
                    </div>
                </div>

                <!-- Section: Professional Info -->
                <h6 class="text-secondary small fw-bold text-uppercase mb-3">2. Service & Coverage</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label for="primaryService" class="form-label fw-semibold small">Primary Assistance Specialization</label>
                        <select name="PrimaryServiceType" id="primaryService" class="form-select">
                            @foreach (var type in Enum.GetValues<AssistanceType>())
                            {
                                <option value="@type" selected="@(type == Model.PrimaryServiceType)">@type</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="city" class="form-label fw-semibold small">Primary Operating Region</label>
                        <input type="text" name="City" id="city" class="form-control" value="@Model.City" placeholder="e.g. Cairo - Desert Road Km 28" />
                    </div>
                    <div class="col-12">
                        <label for="bio" class="form-label fw-semibold small">Professional Bio / Equipment Summary</label>
                        <textarea name="Bio" id="bio" rows="3" class="form-control" placeholder="Describe your mechanical expertise, tools, and roadside assistance capabilities...">@Model.Bio</textarea>
                    </div>
                </div>

                <!-- Section: Verification & Vehicle Equipment -->
                <h6 class="text-secondary small fw-bold text-uppercase mb-3">3. Verification & Equipment Identifiers (SAD UC-02)</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label for="plate" class="form-label fw-semibold small">Tow / Service Van Plate</label>
                        <input type="text" name="VehiclePlateNumber" id="plate" class="form-control" value="@Model.VehiclePlateNumber" placeholder="e.g. ق أ ج 4921" />
                    </div>
                    <div class="col-md-4">
                        <label for="license" class="form-label fw-semibold small">Driver / Trade License</label>
                        <input type="text" name="DriverLicenseNumber" id="license" class="form-control" value="@Model.DriverLicenseNumber" placeholder="e.g. DL-882941" />
                    </div>
                    <div class="col-md-4">
                        <label for="nationalId" class="form-label fw-semibold small">National ID Number</label>
                        <input type="text" name="NationalId" id="nationalId" class="form-control" value="@Model.NationalId" placeholder="14-digit National ID" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Dashboard" class="btn btn-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-emergency fw-bold px-4 shadow">
                        <i class="bi bi-save me-1"></i> Save Profile Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelector("form[action*='Profile']")?.addEventListener("submit", function (e) {
            const nameInput = document.getElementById("fullName");
            const phoneInput = document.getElementById("phone");
            let isValid = true;

            if (!nameInput.value || nameInput.value.trim().length < 3) {
                nameInput.classList.add("is-invalid");
                isValid = false;
            } else {
                nameInput.classList.remove("is-invalid");
            }

            if (!phoneInput.value || phoneInput.value.trim().length < 7) {
                phoneInput.classList.add("is-invalid");
                isValid = false;
            } else {
                phoneInput.classList.remove("is-invalid");
            }

            if (!isValid) {
                e.preventDefault();
                alert("Please correct the highlighted fields before submitting.");
            }
        });
    </script>
}
