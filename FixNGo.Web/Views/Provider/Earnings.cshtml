@model ProviderEarningsDto
@{
    ViewData["Title"] = "Provider Earnings & Settlement - FixNGo";
}

<!-- Flash Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-4 pb-2 border-bottom">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small">
            <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-secondary text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active text-body" aria-current="page">Earnings & Settlement</li>
        </ol>
    </nav>
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h2 class="fw-bold mb-1">Earnings & Settlement Summary</h2>
            <p class="text-secondary mb-0">Track completed mission revenues, cash collections, and pending platform payouts.</p>
        </div>
        <div class="badge bg-secondary-subtle text-body border px-3 py-2 fs-6">
            <i class="bi bi-wallet2 me-1"></i> Currency: <strong>EGP</strong> (Egyptian Pounds)
        </div>
    </div>
</div>

<!-- Time Period Filter Buttons -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div class="btn-group" role="group" aria-label="Earnings Time Period">
        <a asp-action="Earnings" asp-route-period="all" class="btn btn-sm @(ViewBag.SelectedPeriod == "all" ? "btn-warning fw-bold" : "btn-outline-secondary")">
            All Time
        </a>
        <a asp-action="Earnings" asp-route-period="month" class="btn btn-sm @(ViewBag.SelectedPeriod == "month" ? "btn-warning fw-bold" : "btn-outline-secondary")">
            This Month
        </a>
        <a asp-action="Earnings" asp-route-period="today" class="btn btn-sm @(ViewBag.SelectedPeriod == "today" ? "btn-warning fw-bold" : "btn-outline-secondary")">
            Today
        </a>
    </div>
    <span class="text-secondary small">Timeframe: <strong class="text-light">@(ViewBag.SelectedPeriod == "today" ? "Today" : ViewBag.SelectedPeriod == "month" ? "This Month" : "All Time")</strong></span>
</div>

<!-- Financial Metrics Row -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3 mb-4">
    <!-- Gross Revenue -->
    <div class="col">
        <div class="card h-100 border bg-body-tertiary rounded-4 shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary small fw-bold">TOTAL GROSS REVENUE</span>
                <span class="p-2 rounded-3 bg-primary bg-opacity-10 text-primary"><i class="bi bi-cash-stack"></i></span>
            </div>
            <h3 class="fw-bold mb-1">@Model.TotalGrossEarnings.ToString("N0") <span class="fs-6 text-secondary fw-normal">EGP</span></h3>
            <span class="text-secondary small">Across @Model.TotalCompletedJobs completed roadside missions</span>
        </div>
    </div>

    <!-- Paid Amount -->
    <div class="col">
        <div class="card h-100 border bg-body-tertiary rounded-4 shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary small fw-bold">SETTLED / PAID</span>
                <span class="p-2 rounded-3 bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill"></i></span>
            </div>
            <h3 class="fw-bold mb-1 text-success">@Model.PaidAmount.ToString("N0") <span class="fs-6 text-secondary fw-normal">EGP</span></h3>
            <span class="text-secondary small">Cash collected & online payouts cleared</span>
        </div>
    </div>

    <!-- Payable Amount -->
    <div class="col">
        <div class="card h-100 border bg-body-tertiary rounded-4 shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary small fw-bold">PENDING SETTLEMENT</span>
                <span class="p-2 rounded-3 bg-warning bg-opacity-10 text-warning"><i class="bi bi-clock-history"></i></span>
            </div>
            <h3 class="fw-bold mb-1 text-warning">@Model.PayableAmount.ToString("N0") <span class="fs-6 text-secondary fw-normal">EGP</span></h3>
            <span class="text-secondary small">Completed jobs awaiting payout batch</span>
        </div>
    </div>

    <!-- Platform Fee & Policy Note -->
    <div class="col">
        <div class="card h-100 border bg-body-tertiary rounded-4 shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary small fw-bold">PLATFORM FEE (SRS TBD-01)</span>
                <span class="p-2 rounded-3 bg-info bg-opacity-10 text-info"><i class="bi bi-percent"></i></span>
            </div>
            <h3 class="fw-bold mb-1">0% <span class="fs-6 text-secondary fw-normal">Fee</span></h3>
            <span class="text-secondary small">100% credited to provider (Subject to platform policy)</span>
        </div>
    </div>
</div>

<!-- Detailed Transactions Table -->
<div class="card border bg-body-tertiary rounded-4 shadow-sm">
    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1"><i class="bi bi-receipt text-warning me-2"></i>Itemized Service Revenues</h5>
            <p class="text-secondary small mb-0">Record of all completed missions, collected fares, and payment methods.</p>
        </div>
    </div>

    <div class="card-body p-4">
        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="alert alert-secondary border-0 p-4 rounded-3 text-center mb-0">
                <i class="bi bi-inbox fs-2 text-secondary mb-2 d-block"></i>
                <h6 class="fw-bold">No Completed Jobs On Record</h6>
                <p class="text-secondary small mb-0">As you complete roadside assistance missions, each transaction will be recorded here automatically.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="text-secondary small border-bottom">
                        <tr>
                            <th scope="col">DATE</th>
                            <th scope="col">TICKET</th>
                            <th scope="col">SERVICE</th>
                            <th scope="col">CUSTOMER</th>
                            <th scope="col">PAYMENT</th>
                            <th scope="col">STATUS</th>
                            <th scope="col">RATING</th>
                            <th scope="col" class="text-end">AMOUNT (EGP)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.ServiceDate.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    <small class="text-secondary">@item.ServiceDate.ToLocalTime().ToString("hh:mm tt")</small>
                                </td>
                                <td>
                                    <a asp-action="RequestDetails" asp-route-id="@item.RequestId" class="text-warning text-decoration-none fw-bold">
                                        #@item.RequestId
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-body border px-2 py-1">@item.ServiceType</span>
                                </td>
                                <td>@item.CustomerName</td>
                                <td>
                                    <span class="badge @(item.PaymentMethod == "Cash" ? "bg-dark border border-secondary" : "bg-primary-subtle text-primary border border-primary-subtle")">
                                        @item.PaymentMethod
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsPaid)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle-fill me-1"></i>Settled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-clock-history me-1"></i>Payable
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.Rating.HasValue)
                                    {
                                        <div class="text-warning small">
                                            @for (int i = 1; i <= item.Rating.Value; i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">—</span>
                                    }
                                </td>
                                <td class="text-end fw-bold fs-6 text-light">
                                    @item.Amount.ToString("N0") EGP
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
