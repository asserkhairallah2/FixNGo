@model ProviderActiveRequestDto
@{
    ViewData["Title"] = "Active Roadside Mission - FixNGo";
}

<!-- Flash Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null)
{
    <div class="card border bg-body-tertiary rounded-4 shadow-sm p-5 text-center my-4">
        <div class="mb-3">
            <span class="p-4 rounded-circle bg-secondary bg-opacity-10 d-inline-block">
                <i class="bi bi-compass fs-1 text-secondary"></i>
            </span>
        </div>
        <h3 class="fw-bold mb-2">No Active Mission In Progress</h3>
        <p class="text-secondary max-w-md mx-auto mb-4" style="max-width: 500px;">
            You do not currently have an assigned emergency roadside assistance mission. Check the incoming requests pool to accept a new dispatch.
        </p>
        <div>
            <a asp-action="Requests" class="btn btn-emergency px-4 py-2 fw-bold shadow">
                <i class="bi bi-inbox-fill me-1"></i> Browse Incoming Requests
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary px-4 py-2 ms-2">
                Return to Dashboard
            </a>
        </div>
    </div>
}
else
{
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-secondary text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active text-body" aria-current="page">Active Mission</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold mb-0">Mission Tracker #@Model.Id</h2>
                @if (Model.IsP0Emergency)
                {
                    <span class="badge bg-danger text-white fw-bold px-2 py-1">P0 EMERGENCY</span>
                }
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                    @Model.Status
                </span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="tel:@Model.CustomerPhone" class="btn btn-outline-success btn-sm px-3 fw-semibold">
                <i class="bi bi-telephone-fill me-1"></i> Call Driver
            </a>
            <a asp-action="RequestDetails" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm px-3">
                Full Ticket
            </a>
        </div>
    </div>

    <!-- Stepper Lifecycle Progress Tracker: Accepted -> EnRoute -> Arrived -> InService -> Completed -->
    int currentStep = Model.Status switch
    {
        AssistanceRequestStatus.Accepted => 1,
        AssistanceRequestStatus.EnRoute => 2,
        AssistanceRequestStatus.Arrived => 3,
        AssistanceRequestStatus.InService => 4,
        AssistanceRequestStatus.Completed or AssistanceRequestStatus.Paid => 5,
        _ => 1
    };

    <div class="card border bg-body-tertiary rounded-4 shadow-sm p-4 mb-4">
        <h6 class="text-secondary small fw-bold mb-3 text-uppercase">Roadside Mission Lifecycle Progress</h6>

        <div class="position-relative m-2">
            <!-- Progress Line -->
            <div class="progress" style="height: 4px;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: @((currentStep - 1) * 25)%;"></div>
            </div>

            <!-- Stepper Nodes -->
            <div class="position-absolute top-0 start-0 translate-middle d-flex flex-column align-items-center">
                <span class="badge rounded-pill @(currentStep >= 1 ? "bg-warning text-dark" : "bg-secondary text-white") p-2 shadow-sm">
                    <i class="bi bi-check-lg"></i>
                </span>
                <small class="mt-2 text-nowrap fw-semibold @(currentStep == 1 ? "text-warning" : "text-secondary")">1. Accepted</small>
            </div>

            <div class="position-absolute top-0 start-25 translate-middle d-flex flex-column align-items-center" style="left: 25%;">
                <span class="badge rounded-pill @(currentStep >= 2 ? "bg-warning text-dark" : "bg-secondary text-white") p-2 shadow-sm">
                    <i class="bi @(currentStep > 2 ? "bi-check-lg" : "bi-truck")"></i>
                </span>
                <small class="mt-2 text-nowrap fw-semibold @(currentStep == 2 ? "text-warning" : "text-secondary")">2. En Route</small>
            </div>

            <div class="position-absolute top-0 start-50 translate-middle d-flex flex-column align-items-center" style="left: 50%;">
                <span class="badge rounded-pill @(currentStep >= 3 ? "bg-warning text-dark" : "bg-secondary text-white") p-2 shadow-sm">
                    <i class="bi @(currentStep > 3 ? "bi-check-lg" : "bi-geo-alt-fill")"></i>
                </span>
                <small class="mt-2 text-nowrap fw-semibold @(currentStep == 3 ? "text-warning" : "text-secondary")">3. Arrived</small>
            </div>

            <div class="position-absolute top-0 start-75 translate-middle d-flex flex-column align-items-center" style="left: 75%;">
                <span class="badge rounded-pill @(currentStep >= 4 ? "bg-warning text-dark" : "bg-secondary text-white") p-2 shadow-sm">
                    <i class="bi @(currentStep > 4 ? "bi-check-lg" : "bi-wrench-adjustable")"></i>
                </span>
                <small class="mt-2 text-nowrap fw-semibold @(currentStep == 4 ? "text-warning" : "text-secondary")">4. In Service</small>
            </div>

            <div class="position-absolute top-0 start-100 translate-middle d-flex flex-column align-items-center" style="left: 100%;">
                <span class="badge rounded-pill @(currentStep >= 5 ? "bg-success text-white" : "bg-secondary text-white") p-2 shadow-sm">
                    <i class="bi bi-flag-fill"></i>
                </span>
                <small class="mt-2 text-nowrap fw-semibold @(currentStep == 5 ? "text-success" : "text-secondary")">5. Completed</small>
            </div>
        </div>

        <!-- Next Action Transition Button Bar -->
        <div class="mt-5 pt-3 border-top d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div>
                <span class="text-secondary small d-block">CURRENT STEP</span>
                <strong class="fs-5 text-warning">@Model.Status</strong>
            </div>

            <div>
                @if (Model.Status == AssistanceRequestStatus.Accepted)
                {
                    <form asp-action="UpdateStatus" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@AssistanceRequestStatus.EnRoute" />
                        <button type="submit" class="btn btn-warning btn-lg fw-bold px-4 py-2 shadow d-flex align-items-center gap-2">
                            <i class="bi bi-truck"></i> Start Trip (En Route) <i class="bi bi-arrow-right"></i>
                        </button>
                    </form>
                }
                else if (Model.Status == AssistanceRequestStatus.EnRoute)
                {
                    <form asp-action="UpdateStatus" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@AssistanceRequestStatus.Arrived" />
                        <button type="submit" class="btn btn-info btn-lg fw-bold px-4 py-2 shadow d-flex align-items-center gap-2">
                            <i class="bi bi-geo-alt-fill"></i> I Have Arrived At Vehicle <i class="bi bi-arrow-right"></i>
                        </button>
                    </form>
                }
                else if (Model.Status == AssistanceRequestStatus.Arrived)
                {
                    <form asp-action="UpdateStatus" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="newStatus" value="@AssistanceRequestStatus.InService" />
                        <button type="submit" class="btn btn-primary btn-lg fw-bold px-4 py-2 shadow d-flex align-items-center gap-2">
                            <i class="bi bi-wrench-adjustable"></i> Start Service Repair Work <i class="bi bi-arrow-right"></i>
                        </button>
                    </form>
                }
                else if (Model.Status == AssistanceRequestStatus.InService)
                {
                    <button type="button" class="btn btn-success btn-lg fw-bold px-4 py-2 shadow d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#completeServiceModal">
                        <i class="bi bi-check-circle-fill"></i> Complete Service & Confirm Fare <i class="bi bi-arrow-right"></i>
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Active Details & Interactive Communication Grid -->
    <div class="row g-4 mb-4">
        <!-- Left: Breakdown Details & Live Map -->
        <div class="col-lg-7">
            <!-- Breakdown & Location Card -->
            <div class="card border bg-body-tertiary rounded-4 shadow-sm p-4 mb-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-geo-alt text-danger me-2"></i>Destination & Breakdown</h5>
                    <span class="badge bg-secondary-subtle text-body border px-2 py-1">@Model.ServiceType</span>
                </div>

                <div class="p-3 rounded-3 bg-dark bg-opacity-25 border mb-3">
                    <p class="mb-1 text-light fw-bold fs-5">@Model.ProblemDescription</p>
                    <p class="text-secondary small mb-0">
                        <i class="bi bi-pin-map text-danger me-1"></i>@Model.CustomerAddress
                    </p>
                </div>

                <div class="row row-cols-2 g-2 small text-secondary mb-3">
                    <div><strong>Driver:</strong> @Model.CustomerName</div>
                    <div><strong>Vehicle:</strong> @Model.VehicleInfo</div>
                    <div><strong>Plate:</strong> @(Model.VehiclePlateNumber ?? "Not Specified")</div>
                    <div><strong>Estimated Fare:</strong> <span class="text-warning fw-bold">@Model.EstimatedFare.ToString("N0") EGP</span></div>
                </div>

                <!-- Live Map GPS Radar Display -->
                <div class="position-relative rounded-3 overflow-hidden bg-dark border border-secondary" style="height: 240px; background: linear-gradient(135deg, #111827 0%, #1f2937 100%);">
                    <div class="position-absolute w-100 h-100 opacity-25" style="background-image: radial-gradient(#4b5563 1px, transparent 1px); background-size: 20px 20px;"></div>

                    <!-- Customer Destination Marker -->
                    <div class="position-absolute translate-middle text-center" style="top: 35%; left: 65%;">
                        <div class="badge bg-danger text-white shadow-lg p-2 border border-light">
                            <i class="bi bi-car-front-fill me-1"></i> Customer Breakdown
                        </div>
                    </div>

                    <!-- Provider Live Vehicle Marker -->
                    <div class="position-absolute translate-middle text-center" style="top: 65%; left: 35%;" id="providerMapMarker">
                        <div class="badge bg-warning text-dark shadow-lg p-2 border border-light">
                            <i class="bi bi-truck me-1"></i> My Vehicle (You)
                        </div>
                    </div>

                    <div class="position-absolute bottom-0 start-0 p-2">
                        <span class="badge bg-dark bg-opacity-75 text-light border border-secondary small">
                            <i class="bi bi-broadcast text-success me-1"></i> SignalR GPS Radar Active
                        </span>
                    </div>

                    <div class="position-absolute bottom-0 end-0 p-2">
                        <a href="https://maps.google.com/?q=@Model.CustomerLatitude,@Model.CustomerLongitude" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-light">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Google Maps
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Real-time Communication (SignalR In-App Chat) -->
        <div class="col-lg-5">
            <div class="card border bg-body-tertiary rounded-4 shadow-sm h-100 d-flex flex-column">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0"><i class="bi bi-chat-dots-fill text-warning me-2"></i>In-App Chat</h5>
                        <small class="text-secondary">Direct channel with @Model.CustomerName</small>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                        <i class="bi bi-dot"></i>Connected
                    </span>
                </div>

                <div class="card-body p-4 flex-grow-1 d-flex flex-column">
                    <!-- Chat Messages Box -->
                    <div class="flex-grow-1 overflow-auto p-3 rounded-3 bg-dark bg-opacity-25 border mb-3" style="max-height: 280px; min-height: 200px;" id="chatBox">
                        <div class="d-flex flex-column gap-2" id="chatMessages">
                            <div class="p-2 rounded-3 bg-body-secondary text-body small align-self-start" style="max-width: 80%;">
                                <strong>System:</strong> Secure chat initialized for mission #@Model.Id.
                            </div>
                            <div class="p-2 rounded-3 bg-body-secondary text-body small align-self-start" style="max-width: 80%;">
                                <strong>@Model.CustomerName:</strong> Please hurry, we are waiting safely behind the guardrail.
                            </div>
                        </div>
                    </div>

                    <!-- Chat Input Box -->
                    <div class="input-group">
                        <input type="text" id="chatInput" class="form-control" placeholder="Type a message to customer..." />
                        <button class="btn btn-emergency fw-bold" type="button" id="chatSendBtn">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Complete Service Modal -->
    <div class="modal fade" id="completeServiceModal" tabindex="-1" aria-labelledby="completeServiceModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="completeServiceModalLabel"><i class="bi bi-check-circle-fill text-success me-2"></i>Service Completion & Settlement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CompleteService" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-body">
                        <p class="text-secondary small mb-3">
                            Confirm that the roadside emergency service is fully completed and vehicle is roadworthy or towed to the designated workshop.
                        </p>
                        <div class="mb-3">
                            <label for="finalFareAmount" class="form-label fw-semibold">Final Total Service Fee (EGP)</label>
                            <input type="number" step="1" name="finalFare" id="finalFareAmount" class="form-control fs-5 fw-bold" value="@(Model.FinalFare ?? Model.EstimatedFare)" required />
                            <div class="form-text small">Initial estimated fare was: @Model.EstimatedFare.ToString("N0") EGP</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success fw-bold px-4">Confirm & Mark Completed</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <!-- SignalR Client Library -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>

    @if (Model != null)
    {
        <script>
            // Initialize ChatHub Connection
            const requestId = "@Model.Id";
            const providerName = "Provider";

            const chatConnection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/chat")
                .withAutomaticReconnect()
                .build();

            chatConnection.on("ReceiveMessage", function (sender, message) {
                appendChatMessage(sender, message);
            });

            chatConnection.start()
                .then(() => {
                    chatConnection.invoke("JoinChatGroup", requestId);
                })
                .catch(err => console.log("Chat SignalR connect error: ", err));

            function appendChatMessage(sender, message) {
                const box = document.getElementById("chatMessages");
                const msgDiv = document.createElement("div");
                msgDiv.className = "p-2 rounded-3 text-body small " + 
                    (sender === providerName ? "bg-warning bg-opacity-25 align-self-end text-end" : "bg-body-secondary align-self-start");
                msgDiv.style.maxWidth = "80%";
                msgDiv.innerHTML = "<strong>" + sender + ":</strong> " + message;
                box.appendChild(msgDiv);
                document.getElementById("chatBox").scrollTop = document.getElementById("chatBox").scrollHeight;
            }

            document.getElementById("chatSendBtn")?.addEventListener("click", sendMessage);
            document.getElementById("chatInput")?.addEventListener("keydown", function (e) {
                if (e.key === "Enter") sendMessage();
            });

            function sendMessage() {
                const input = document.getElementById("chatInput");
                const text = input.value.trim();
                if (!text) return;

                chatConnection.invoke("SendMessage", requestId, providerName, text)
                    .catch(err => console.log("Send message error: ", err));

                input.value = "";
            }
        </script>
    }
}
