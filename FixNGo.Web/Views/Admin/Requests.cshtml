@model FixNGo.Web.ViewModels.AdminRequestsViewModel
@using FixNGo.Domain.Entities
@using FixNGo.Domain.Enums
@{
    ViewData["Title"] = "Roadside Dispatch Oversight - Admin";
    var providers = ViewBag.AvailableProviders as List<ProviderProfile> ?? new List<ProviderProfile>();
}

<partial name="_AdminNav" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0"><i class="bi bi-telephone-inbound-fill text-danger me-2"></i>Roadside Dispatch & Coordination</h3>
        <p class="text-secondary m-0">Coordinate between clients in emergency need and available verified providers.</p>
    </div>
</div>

<!-- Search and Filter Form -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-body-tertiary border-secondary-subtle"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by customer name, address, or problem description..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Request Statuses --</option>
                    @foreach (var s in Enum.GetValues<AssistanceRequestStatus>())
                    {
                        <option value="@s" selected="@(Model.SelectedStatus == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-danger px-3"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Requests" class="btn btn-outline-secondary px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Requests Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>Ticket</th>
                        <th>Client</th>
                        <th>Service / Issue</th>
                        <th>Assigned Provider</th>
                        <th>Status</th>
                        <th>Fare</th>
                        <th>Coordination Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Requests.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No roadside requests matching the criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var req in Model.Requests)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold">#REQ-@req.Id</span>
                                <small class="d-block text-muted">@req.CreatedAt.ToString("MMM dd, HH:mm")</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@(req.Customer?.FullName ?? req.CustomerId)</div>
                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@req.CustomerAddress</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-body border mb-1">@req.ServiceType</span>
                                <div class="small text-truncate" style="max-width: 200px;" title="@req.ProblemDescription">
                                    @(req.ProblemDescription ?? "No description provided")
                                </div>
                            </td>
                            <td>
                                @if (req.Provider != null)
                                {
                                    <div class="fw-semibold text-primary">
                                        <i class="bi bi-person-check-fill me-1"></i>@req.Provider.FullName
                                    </div>
                                    <small class="text-muted">@req.Provider.PhoneNumber</small>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                        <i class="bi bi-exclamation-circle me-1"></i>Unassigned
                                    </span>
                                }
                            </td>
                            <td>
                                @switch (req.Status)
                                {
                                    case AssistanceRequestStatus.Open:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Open</span>
                                        break;
                                    case AssistanceRequestStatus.Accepted:
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Accepted</span>
                                        break;
                                    case AssistanceRequestStatus.EnRoute:
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">En Route</span>
                                        break;
                                    case AssistanceRequestStatus.Arrived:
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Arrived</span>
                                        break;
                                    case AssistanceRequestStatus.Completed:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Completed</span>
                                        break;
                                    case AssistanceRequestStatus.Cancelled:
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td class="fw-bold text-success">
                                @req.EstimatedFare.ToString("N0") EGP
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    @if (req.Status != AssistanceRequestStatus.Completed && req.Status != AssistanceRequestStatus.Cancelled)
                                    {
                                        <!-- Assign / Reassign Provider Dropdown Form -->
                                        <form asp-action="AssignProvider" method="post" class="d-flex gap-1 align-items-center m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@req.Id" />
                                            <select name="providerId" class="form-select form-select-sm" style="width: 140px;" required>
                                                <option value="">Assign To...</option>
                                                @foreach (var p in providers)
                                                {
                                                    <option value="@p.UserId" selected="@(p.UserId == req.ProviderId)">
                                                        @(p.User?.FullName ?? p.UserId)
                                                    </option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Assign / Reassign">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>

                                        <!-- Cancel Request Form -->
                                        <form asp-action="CancelRequest" method="post" class="m-0" onsubmit="return confirm('Cancel this roadside request?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="requestId" value="@req.Id" />
                                            <input type="hidden" name="reason" value="Cancelled by Admin oversight." />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel Request">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Closed</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-transparent py-3">
                <nav aria-label="Requests navigation">
                    <ul class="pagination pagination-sm justify-content-center m-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Requests" asp-route-page="@(Model.CurrentPage - 1)" asp-route-status="@Model.SelectedStatus" asp-route-search="@Model.Search">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Requests" asp-route-page="@p" asp-route-status="@Model.SelectedStatus" asp-route-search="@Model.Search">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Requests" asp-route-page="@(Model.CurrentPage + 1)" asp-route-status="@Model.SelectedStatus" asp-route-search="@Model.Search">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
