@model FixNGo.Web.ViewModels.AdminBookingsViewModel
@using FixNGo.Domain.Enums
@{
    ViewData["Title"] = "Service Center Bookings Oversight - Admin";
}

<partial name="_AdminNav" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0"><i class="bi bi-calendar2-check-fill text-danger me-2"></i>Service Center Bookings Oversight</h3>
        <p class="text-secondary m-0">Monitor and coordinate client appointments across all verified service centers.</p>
    </div>
</div>

<!-- Search and Filter Form -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-body-tertiary border-secondary-subtle"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by customer, center, or service name..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Booking Statuses --</option>
                    @foreach (var s in Enum.GetValues<BookingStatus>())
                    {
                        <option value="@s" selected="@(Model.SelectedStatus == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-danger px-3"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Bookings" class="btn btn-outline-secondary px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Bookings Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>Booking #</th>
                        <th>Client</th>
                        <th>Service Center</th>
                        <th>Service &amp; Price</th>
                        <th>Appointment</th>
                        <th>Status</th>
                        <th>Admin Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Bookings.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                                No center bookings found matching the criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var b in Model.Bookings)
                    {
                        <tr>
                            <td>
                                <span class="fw-bold">#BK-@b.Id</span>
                                <small class="d-block text-muted">@b.CreatedAt.ToString("MMM dd, HH:mm")</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@(b.Customer?.FullName ?? b.CustomerId)</div>
                                <small class="text-muted">@(b.Customer?.PhoneNumber ?? "No phone")</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@(b.ServiceCenter?.Name ?? "Center #" + b.ServiceCenterId)</div>
                                <small class="text-muted">@(b.ServiceCenter?.Address?.Contains("Giza") == true ? "Giza" : "Cairo")</small>
                            </td>
                            <td>
                                <span class="fw-semibold">@(b.Service?.Name ?? "Service #" + b.ServiceId)</span>
                                <div class="small fw-bold text-success">@b.Price.ToString("N0") EGP</div>
                                @if (!string.IsNullOrEmpty(b.Notes))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 180px;">"@b.Notes"</small>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold">@b.AppointmentDate.ToString("yyyy-MM-dd")</div>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@b.AppointmentTime</small>
                            </td>
                            <td>
                                @switch (b.Status)
                                {
                                    case BookingStatus.Pending:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                                        break;
                                    case BookingStatus.Confirmed:
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Confirmed</span>
                                        break;
                                    case BookingStatus.Completed:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Completed</span>
                                        break;
                                    case BookingStatus.Rejected:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rejected</span>
                                        break;
                                    case BookingStatus.Cancelled:
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td>
                                <form asp-action="UpdateBookingStatus" method="post" class="d-flex gap-1 align-items-center m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@b.Id" />
                                    <select name="newStatus" class="form-select form-select-sm" style="width: 120px;">
                                        @foreach (var s in Enum.GetValues<BookingStatus>())
                                        {
                                            <option value="@s" selected="@(b.Status == s)">@s</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Update Status">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-transparent py-3">
                <nav aria-label="Bookings navigation">
                    <ul class="pagination pagination-sm justify-content-center m-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Bookings" asp-route-page="@(Model.CurrentPage - 1)" asp-route-status="@Model.SelectedStatus" asp-route-search="@Model.Search">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Bookings" asp-route-page="@p" asp-route-status="@Model.SelectedStatus" asp-route-search="@Model.Search">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Bookings" asp-route-page="@(Model.CurrentPage + 1)" asp-route-status="@Model.SelectedStatus" asp-route-search="@Model.Search">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
