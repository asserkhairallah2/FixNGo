@model FixNGo.Web.ViewModels.AdminUsersViewModel
@{
    ViewData["Title"] = "User Management - Admin";
}

<partial name="_AdminNav" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0"><i class="bi bi-people-fill text-danger me-2"></i>User &amp; Account Governance</h3>
        <p class="text-secondary m-0">Manage customer and provider accounts, roles, access permissions, and account status.</p>
    </div>
</div>

<!-- Search and Role Filter -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-body-tertiary border-secondary-subtle"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name, email, or phone number..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="role" class="form-select">
                    <option value="">-- All Roles --</option>
                    <option value="Admin" selected="@(Model.SelectedRole == "Admin")">Admin</option>
                    <option value="Provider" selected="@(Model.SelectedRole == "Provider")">Provider</option>
                    <option value="Customer" selected="@(Model.SelectedRole == "Customer")">Customer</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-danger px-3"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Users" class="btn btn-outline-secondary px-3">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Users Table -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase">
                    <tr>
                        <th>User</th>
                        <th>Contact</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Registered Date</th>
                        <th>Access Control</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-2 d-block mb-2"></i>
                                No users found matching the query.
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="p-2 bg-body-tertiary rounded-circle me-2 text-danger fs-5">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div>
                                        <span class="fw-semibold d-block">@user.FullName</span>
                                        <small class="text-muted">ID: @user.Id.Substring(0, Math.Min(user.Id.Length, 8))...</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div><i class="bi bi-envelope me-1 text-secondary"></i>@user.Email</div>
                                <small class="text-muted"><i class="bi bi-telephone me-1"></i>@user.PhoneNumber</small>
                            </td>
                            <td>
                                @switch (user.Role)
                                {
                                    case "Admin":
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-shield-lock me-1"></i>Admin
                                        </span>
                                        break;
                                    case "Provider":
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-tools me-1"></i>Provider
                                        </span>
                                        break;
                                    default:
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-person me-1"></i>Customer
                                        </span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                        <i class="bi bi-slash-circle me-1"></i>Suspended
                                    </span>
                                }
                            </td>
                            <td>
                                <small class="text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</small>
                            </td>
                            <td>
                                <form asp-action="ToggleUserStatus" method="post" class="m-0" onsubmit="return confirm('Change access status for @user.FullName?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    @if (user.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Suspend Account">
                                            <i class="bi bi-slash-circle me-1"></i>Suspend
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Reactivate Account">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reactivate
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-transparent py-3">
                <nav aria-label="Users navigation">
                    <ul class="pagination pagination-sm justify-content-center m-0">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Users" asp-route-page="@(Model.CurrentPage - 1)" asp-route-role="@Model.SelectedRole" asp-route-search="@Model.Search">Previous</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Users" asp-route-page="@p" asp-route-role="@Model.SelectedRole" asp-route-search="@Model.Search">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Users" asp-route-page="@(Model.CurrentPage + 1)" asp-route-role="@Model.SelectedRole" asp-route-search="@Model.Search">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
