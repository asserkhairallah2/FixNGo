@model FixNGo.Web.ViewModels.AdminProvidersViewModel
@using FixNGo.Domain.Enums
@{
    ViewData["Title"] = "Provider Verification Queue - Admin";
}

<partial name="_AdminNav" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0"><i class="bi bi-patch-check-fill text-danger me-2"></i>Provider Verification & KYC Queue</h3>
        <p class="text-secondary m-0">Review trade licenses, national IDs, and authorize service providers to take live requests.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Providers" asp-route-status="@VerificationStatus.Pending" class="btn btn-outline-warning btn-sm @(Model.SelectedStatus == VerificationStatus.Pending ? "active" : "")">
            <i class="bi bi-hourglass-split me-1"></i>Pending Review (@Model.PendingCount)
        </a>
        <a asp-action="Providers" asp-route-status="@VerificationStatus.Verified" class="btn btn-outline-success btn-sm @(Model.SelectedStatus == VerificationStatus.Verified ? "active" : "")">
            <i class="bi bi-patch-check-fill me-1"></i>Verified (@Model.VerifiedCount)
        </a>
        <a asp-action="Providers" class="btn btn-outline-secondary btn-sm @(!Model.SelectedStatus.HasValue ? "active" : "")">
            All Providers
        </a>
    </div>
</div>

<div class="row g-4">
    @if (!Model.Providers.Any())
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-3 p-5 text-center text-muted">
                <i class="bi bi-person-check fs-1 d-block mb-3 text-secondary"></i>
                <h5>No provider profiles in this queue</h5>
                <p class="small">All applications have been reviewed or no providers match the selected status.</p>
            </div>
        </div>
    }
    @foreach (var p in Model.Providers)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <span class="badge @(p.VerificationStatus == VerificationStatus.Verified ? "bg-success-subtle text-success border border-success-subtle" : p.VerificationStatus == VerificationStatus.Pending ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                        @p.VerificationStatus
                    </span>
                    <small class="text-muted"><i class="bi bi-star-fill text-warning me-1"></i>@p.Rating.ToString("F1") (@p.TotalReviews)</small>
                </div>
                <div class="card-body p-3">
                    <h5 class="fw-bold mb-1">@(p.User?.FullName ?? p.UserId)</h5>
                    <p class="text-muted small mb-3">
                        <i class="bi bi-telephone me-1 text-success"></i>@(p.User?.PhoneNumber ?? "No phone") • 
                        <i class="bi bi-geo-alt me-1 text-danger"></i>@(p.City ?? "Egypt")
                    </p>

                    <div class="bg-body-tertiary p-2 rounded-2 small mb-3">
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-secondary">Specialization:</span>
                            <strong>@p.PrimaryServiceType</strong>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-secondary">Plate Number:</span>
                            <code>@(p.VehiclePlateNumber ?? "Pending")</code>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-secondary">Driver License:</span>
                            <code>@(p.DriverLicenseNumber ?? "Pending")</code>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-secondary">National ID:</span>
                            <code>@(p.NationalId ?? "Pending")</code>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-secondary">Completed Missions:</span>
                            <strong>@p.CompletedJobsCount</strong>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(p.Bio))
                    {
                        <p class="small text-secondary mb-3 fst-italic">"@p.Bio"</p>
                    }
                </div>
                <div class="card-footer bg-transparent py-3 border-top d-flex gap-2 justify-content-end">
                    <!-- Approve Application Form -->
                    <form asp-action="VerifyProvider" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="providerId" value="@p.UserId" />
                        <input type="hidden" name="approve" value="true" />
                        <button type="submit" class="btn btn-sm btn-success px-3 fw-semibold" @(p.VerificationStatus == VerificationStatus.Verified ? "disabled" : "")>
                            <i class="bi bi-check2 me-1"></i>Approve &amp; Verify
                        </button>
                    </form>

                    <!-- Reject Application Form -->
                    <form asp-action="VerifyProvider" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="providerId" value="@p.UserId" />
                        <input type="hidden" name="approve" value="false" />
                        <button type="submit" class="btn btn-sm btn-outline-danger px-3" @(p.VerificationStatus == VerificationStatus.Rejected ? "disabled" : "")>
                            <i class="bi bi-x-lg me-1"></i>Reject
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
