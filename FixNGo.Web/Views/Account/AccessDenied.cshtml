@{
    ViewData["Title"] = "Access Denied - FixNGo";
}

<div class="row justify-content-center my-5 text-center">
    <div class="col-md-6">
        <div class="card border bg-body-tertiary rounded-4 shadow-sm p-5">
            <div class="mb-3 text-danger">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h3 class="fw-bold mb-2">Access Denied</h3>
            <p class="text-secondary mb-4">
                You do not have the required role or authorization to access this page. Protected provider pages require an authenticated provider account.
            </p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 me-2">Back to Home</a>
                <a asp-action="QuickLogin" asp-route-role="Provider" class="btn btn-emergency px-4 fw-bold">Sign In as Provider</a>
            </div>
        </div>
    </div>
</div>
