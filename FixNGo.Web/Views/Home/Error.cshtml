@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <h2 class="fw-bold">Something went wrong</h2>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        <i class="bi bi-house me-1"></i>Return to Home
    </a>
</div>

