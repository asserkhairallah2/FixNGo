@model FixNGo.Domain.Entities.ServiceCenter
@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-4">
    <a asp-controller="ServiceCenters" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">
        <i class="bi bi-arrow-left me-1"></i>Back to Directory
    </a>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-0">@Model.Name</h2>
            @if (!string.IsNullOrEmpty(Model.NameEn))
            {
                <h5 class="text-muted">@Model.NameEn</h5>
            }
        </div>
        <span class="badge bg-primary px-3 py-2 fs-6">
            <i class="bi bi-star-fill text-warning me-1"></i>@Model.Rating.ToString("F1") / 5.0
        </span>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-tools text-primary me-2"></i>Offered Services</h5>
                <a asp-controller="Bookings" asp-action="Create" asp-route-serviceCenterId="@Model.Id" class="btn btn-primary btn-sm">
                    <i class="bi bi-calendar-check me-1"></i> Book Appointment
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.Services.Any())
                {
                    <p class="text-muted p-3 mb-0">No services cataloged yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var s in Model.Services)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <h6 class="mb-1 fw-bold">@s.Name</h6>
                                    @if (!string.IsNullOrEmpty(s.Description))
                                    {
                                        <small class="text-muted">@s.Description</small>
                                    }
                                </div>
                                <div class="text-end">
                                    <span class="fs-5 fw-bold text-success">@s.Price.ToString("N0") EGP</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock text-primary me-2"></i>Working Hours</h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.WorkingHours.Any())
                {
                    <p class="text-muted p-3 mb-0">Operating hours not specified.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var wh in Model.WorkingHours.OrderBy(w => w.DayOfWeek))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <span>@wh.DayOfWeek</span>
                                @if (wh.IsClosed)
                                {
                                    <span class="badge bg-danger-subtle text-danger">Closed</span>
                                }
                                else
                                {
                                    <span class="text-secondary small">@wh.OpenTime.ToString(@"hh\:mm") - @wh.CloseTime.ToString(@"hh\:mm")</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-geo-alt text-danger me-2"></i>Contact & Location</h5>
            </div>
            <div class="card-body">
                <p class="mb-2"><i class="bi bi-geo-alt text-secondary me-2"></i>@Model.Address</p>
                <p class="mb-3"><i class="bi bi-telephone text-secondary me-2"></i>@Model.Phone</p>
                <div class="p-2 bg-light rounded text-center small text-muted">
                    GPS: @Model.Latitude.ToString("F4"), @Model.Longitude.ToString("F4")
                </div>
            </div>
        </div>
    </div>
</div>