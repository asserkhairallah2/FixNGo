@{
    ViewData["Title"] = "Center Dashboard";
}

<div class="container py-4">
    <!-- Header Summary Card -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle fs-3 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px;">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                    <div>
                        <h2 class="fw-bold mb-1 text-body">Al-Nasr Certified Service Center</h2>
                        <div class="text-muted small">
                            <i class="bi bi-geo-alt me-1"></i>Nasr City, Cairo, Egypt &bull; Management Hub
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-check-circle-fill me-1"></i>Active
                    </span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6 rounded-pill">
                        <i class="bi bi-patch-check-fill me-1"></i>Verified Center
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- 5 Hub Navigation Cards Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <!-- 1. Center Profile -->
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 h-100 position-relative">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <i class="bi bi-arrow-right-short fs-3 text-muted"></i>
                    </div>
                    <h5 class="fw-bold text-body mb-2">Center Profile</h5>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Manage center contact info, street address, location coordinates, and active availability.
                    </p>
                    <a asp-controller="ServiceCenters" asp-action="Profile" class="stretched-link text-decoration-none fw-semibold small text-primary">
                        Open Profile <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 2. Verification Documents -->
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 h-100 position-relative">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="p-3 bg-info-subtle text-info rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi bi-file-earmark-check-fill"></i>
                        </div>
                        <i class="bi bi-arrow-right-short fs-3 text-muted"></i>
                    </div>
                    <h5 class="fw-bold text-body mb-2">Verification Documents</h5>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Upload and track review status of commercial register, tax card, and business licenses.
                    </p>
                    <a asp-controller="ServiceCenters" asp-action="VerificationDocuments" class="stretched-link text-decoration-none fw-semibold small text-info">
                        Open Documents <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. Working Hours -->
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 h-100 position-relative">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="p-3 bg-warning-subtle text-warning rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi bi-clock-fill"></i>
                        </div>
                        <i class="bi bi-arrow-right-short fs-3 text-muted"></i>
                    </div>
                    <h5 class="fw-bold text-body mb-2">Working Hours</h5>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Configure weekly schedule, open and close times for each day, or designate days off.
                    </p>
                    <a asp-controller="ServiceCenters" asp-action="WorkingHours" asp-route-id="1" class="stretched-link text-decoration-none fw-semibold small text-warning">
                        Configure Hours <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 4. Services & Prices -->
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 h-100 position-relative">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="p-3 bg-success-subtle text-success rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi bi-wrench-adjustable-circle-fill"></i>
                        </div>
                        <i class="bi bi-arrow-right-short fs-3 text-muted"></i>
                    </div>
                    <h5 class="fw-bold text-body mb-2">Services & Prices</h5>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Manage your repair services catalog, toggle availability, set prices in EGP, and apply discount offers.
                    </p>
                    <a asp-controller="ServiceCenters" asp-action="Services" class="stretched-link text-decoration-none fw-semibold small text-success">
                        Manage Services <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- 5. Bookings Dashboard -->
        <div class="col">
            <div class="card shadow-sm border-0 rounded-3 h-100 position-relative">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="p-3 bg-danger-subtle text-danger rounded-3 fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>
                        <i class="bi bi-arrow-right-short fs-3 text-muted"></i>
                    </div>
                    <h5 class="fw-bold text-body mb-2">Bookings Dashboard</h5>
                    <p class="text-muted small mb-4 flex-grow-1">
                        Review customer appointment requests in real-time and accept or reject pending bookings.
                    </p>
                    <a asp-controller="Bookings" asp-action="Dashboard" class="stretched-link text-decoration-none fw-semibold small text-danger">
                        View Bookings <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
