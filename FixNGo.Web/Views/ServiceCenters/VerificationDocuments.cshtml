@model FixNGo.Web.Models.VerificationDocumentsViewModel
@{
    ViewData["Title"] = "Verification Documents";
}

<div class="container py-3">
    <!-- Breadcrumb and Top Navigation -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-2">
            <i class="bi bi-arrow-left me-1"></i>Back to Centers
        </a>
    </div>

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-patch-check-fill text-warning me-2"></i>Verification Documents
            </h2>
            <p class="text-muted mb-0">
                <i class="bi bi-buildings me-1"></i>@Model.CenterName
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="#upload-section" class="btn btn-primary btn-sm rounded-2 shadow-sm">
                <i class="bi bi-cloud-arrow-up-fill me-1"></i>Upload New Document
            </a>
        </div>
    </div>

    <!-- Success Message Notification -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4 rounded-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-2 text-success"></i>
                <div>
                    <strong>Success!</strong> @TempData["Success"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Compliance Status Overview -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-3 text-center text-md-start border-md-end">
                    <span class="text-muted small d-block">Overall Status</span>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-6 mt-1 px-3 py-2">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>Action Required
                    </span>
                </div>
                <div class="col-md-9">
                    <div class="row text-center g-2">
                        <div class="col-4">
                            <div class="p-2 bg-body-tertiary rounded-3">
                                <span class="fs-4 fw-bold text-success">@Model.Documents.Count(d => d.Status == FixNGo.Web.Models.DocumentStatus.Approved)</span>
                                <small class="text-muted d-block">Approved</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-body-tertiary rounded-3">
                                <span class="fs-4 fw-bold text-warning">@Model.Documents.Count(d => d.Status == FixNGo.Web.Models.DocumentStatus.Pending)</span>
                                <small class="text-muted d-block">Under Review</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-body-tertiary rounded-3">
                                <span class="fs-4 fw-bold text-danger">@Model.Documents.Count(d => d.Status == FixNGo.Web.Models.DocumentStatus.Rejected)</span>
                                <small class="text-muted d-block">Rejected</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Required Documents Table & Cards -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-body py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-folder2-open text-primary me-2"></i>Official Compliance Records
            </h5>
            <span class="badge bg-secondary-subtle text-secondary">
                @Model.Documents.Count Documents
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 32%;">Document</th>
                            <th scope="col" style="width: 18%;">File Info</th>
                            <th scope="col" style="width: 15%;">Upload Date</th>
                            <th scope="col" style="width: 15%;">Status</th>
                            <th scope="col" class="text-end" style="width: 20%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-3 fs-3 text-secondary">
                                            <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@doc.TitleEn</h6>
                                        </div>
                                    </div>

                                    @* Display Rejection Reason when the document is rejected *@
                                    @if (doc.Status == FixNGo.Web.Models.DocumentStatus.Rejected && !string.IsNullOrEmpty(doc.RejectionReason))
                                    {
                                        <div class="alert alert-danger py-2 px-3 mt-2 mb-1 rounded-2 border-0 shadow-sm small">
                                            <div class="d-flex align-items-start">
                                                <i class="bi bi-x-circle-fill text-danger me-2 mt-1 fs-6"></i>
                                                <div>
                                                    <strong class="d-block text-danger">Rejection Reason:</strong>
                                                    <span>@doc.RejectionReason</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="d-block small text-truncate" style="max-width: 180px;" title="@doc.FileName">
                                        <i class="bi bi-paperclip me-1"></i>@doc.FileName
                                    </span>
                                    <small class="text-muted">@doc.FileSize</small>
                                </td>
                                <td>
                                    <span class="small">@doc.UploadedAt.ToString("yyyy-MM-dd")</span>
                                    <small class="text-muted d-block">@doc.UploadedAt.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    @switch (doc.Status)
                                    {
                                        case FixNGo.Web.Models.DocumentStatus.Approved:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle-fill me-1"></i>Approved
                                            </span>
                                            break;
                                        case FixNGo.Web.Models.DocumentStatus.Pending:
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                <i class="bi bi-hourglass-split me-1"></i>Under Review
                                            </span>
                                            break;
                                        case FixNGo.Web.Models.DocumentStatus.Rejected:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Rejected
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary" title="View">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" title="Download">
                                            <i class="bi bi-download"></i>
                                        </button>
                                        @if (doc.Status == FixNGo.Web.Models.DocumentStatus.Rejected)
                                        {
                                            <a href="#upload-section" class="btn btn-danger btn-sm" title="Re-upload">
                                                <i class="bi bi-arrow-repeat me-1"></i>Re-upload
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Document Upload Card (Static Form) -->
    <div class="card shadow-sm border-0 rounded-3" id="upload-section">
        <div class="card-header bg-body py-3 border-bottom">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-cloud-arrow-up text-primary me-2"></i>Upload Verification Document
            </h5>
            <small class="text-muted">
                Allowed formats: PDF, JPG, PNG (Max 5MB). Files are encrypted and checked by FixNGo quality assurance.
            </small>
        </div>
        <div class="card-body p-4">
            <form asp-action="VerificationDocuments" asp-route-id="@Model.CenterId" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Document Type Dropdown (The 4 Egyptian Types) -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Document Type <span class="text-danger">*</span>
                        </label>
                        <select class="form-select" asp-for="NewDocument.DocumentType" required>
                            <option value="" selected disabled>-- Select Document --</option>
                            <option value="CommercialRegister">Commercial Register</option>
                            <option value="TaxCard">Tax Card</option>
                            <option value="ShopOperatingLicense">Shop Operating License</option>
                            <option value="OwnerNationalId">Owner National ID</option>
                        </select>
                    </div>

                    <!-- File Selection -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Choose Document File <span class="text-danger">*</span>
                        </label>
                        <input type="file" class="form-control" asp-for="NewDocument.File" accept=".pdf,.jpg,.jpeg,.png" required />
                    </div>

                    <!-- Notes / Comments -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            Notes or Commercial Reference Number (Optional)
                        </label>
                        <input type="text" class="form-control" asp-for="NewDocument.Notes" placeholder="e.g. Commercial Registry No. 104523" />
                    </div>

                    <!-- Submit Button -->
                    <div class="col-12 text-end pt-2">
                        <button type="submit" class="btn btn-primary px-4 py-2 rounded-2">
                            <i class="bi bi-upload me-1"></i>Upload Document
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
