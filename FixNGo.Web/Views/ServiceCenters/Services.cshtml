@model FixNGo.Web.Models.CenterServicesViewModel
@{
    ViewData["Title"] = "Center Services & Prices";
}

<div class="container py-3">
    <!-- Breadcrumb and Top Navigation -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-2">
            <i class="bi bi-arrow-left me-1"></i>Back to Centers
        </a>
    </div>

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-tools text-primary me-2"></i>Services & Price List
            </h2>
            <p class="text-muted mb-0">
                <i class="bi bi-buildings me-1"></i>@Model.CenterName
            </p>
        </div>
        <div>
            <a href="#add-service-section" class="btn btn-primary btn-sm rounded-2 shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i>Add New Service
            </a>
        </div>
    </div>

    <!-- Success Message Notification -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4 rounded-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-2 text-success"></i>
                <div>
                    <strong>Success!</strong> @TempData["Success"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI / Overview Counters -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-3 text-center text-md-start border-md-end">
                    <span class="text-muted small d-block">Catalog Summary</span>
                    <h5 class="fw-bold mb-0 mt-1">Services Overview</h5>
                </div>
                <div class="col-md-9">
                    <div class="row text-center g-2">
                        <div class="col-4">
                            <div class="p-2 bg-body-tertiary rounded-3">
                                <span class="fs-4 fw-bold text-primary">@Model.Services.Count</span>
                                <small class="text-muted d-block">Total Services</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-body-tertiary rounded-3">
                                <span class="fs-4 fw-bold text-success">@Model.Services.Count(s => s.IsAvailable)</span>
                                <small class="text-muted d-block">Available</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 bg-body-tertiary rounded-3">
                                <span class="fs-4 fw-bold text-warning">@Model.Services.Count(s => !string.IsNullOrEmpty(s.Offer))</span>
                                <small class="text-muted d-block">Active Offers</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Services Table Card -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-body py-3 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-list-check text-primary me-2"></i>Offered Services
            </h5>
            <span class="badge bg-secondary-subtle text-secondary">
                @Model.Services.Count Services
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 35%;">Service Name</th>
                            <th scope="col" style="width: 15%;">Price (EGP)</th>
                            <th scope="col" style="width: 20%;">Availability</th>
                            <th scope="col" style="width: 15%;">Offer</th>
                            <th scope="col" class="text-end" style="width: 15%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in Model.Services)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-3 fs-4 text-primary">
                                            <i class="bi bi-gear-wide-connected"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">@service.Name</h6>
                                            @if (!string.IsNullOrEmpty(service.Description))
                                            {
                                                <small class="text-muted d-block">@service.Description</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fs-6 fw-bold text-success">@service.Price.ToString("N0") EGP</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" role="switch" @(service.IsAvailable ? "checked" : "") disabled />
                                        </div>
                                        @if (service.IsAvailable)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                Available
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                Unavailable
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(service.Offer))
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-tag-fill me-1"></i>@service.Offer
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No offer</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-outline-secondary" title="Edit Service">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" title="Delete Service">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add New Service Card (Static Form) -->
    <div class="card shadow-sm border-0 rounded-3" id="add-service-section">
        <div class="card-header bg-body py-3 border-bottom">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-plus-circle text-primary me-2"></i>Add New Service
            </h5>
            <small class="text-muted">
                Define the service details, pricing in Egyptian Pounds (EGP), and optional discounts.
            </small>
        </div>
        <div class="card-body p-4">
            <form asp-action="Services" asp-route-id="@Model.CenterId" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Service Name -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Service Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" asp-for="NewService.Name" placeholder="e.g. Wheel Alignment & Balancing" required />
                    </div>

                    <!-- Price (EGP) -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Price (EGP) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <input type="number" step="10" min="0" class="form-control" asp-for="NewService.Price" placeholder="e.g. 500" required />
                            <span class="input-group-text">EGP</span>
                        </div>
                    </div>

                    <!-- Offer (Optional Text) -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Offer / Discount (Optional)
                        </label>
                        <input type="text" class="form-control" asp-for="NewService.Offer" placeholder="e.g. 15% OFF or 50 EGP OFF" />
                    </div>

                    <!-- Availability Checkbox -->
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check form-switch pt-md-4">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="NewService.IsAvailable" id="availabilitySwitch" checked />
                            <label class="form-check-label fw-semibold ms-2" for="availabilitySwitch">
                                Available for Booking
                            </label>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            Description (Optional)
                        </label>
                        <textarea class="form-control" asp-for="NewService.Description" rows="2" placeholder="Brief explanation of what this service covers..."></textarea>
                    </div>

                    <!-- Submit Button -->
                    <div class="col-12 text-end pt-2">
                        <button type="submit" class="btn btn-primary px-4 py-2 rounded-2">
                            <i class="bi bi-plus-circle me-1"></i>Add Service
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
