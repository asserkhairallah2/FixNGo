@model IEnumerable<FixNGo.Domain.Entities.WorkingHours>

@{
    ViewData["Title"] = "Manage Working Hours";
    var centerId = ViewContext.RouteData.Values["id"] ?? Context.Request.Query["id"];
    var hoursList = Model?.ToList() ?? new List<FixNGo.Domain.Entities.WorkingHours>();

    string[] dayNames = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
    string[] dayNamesAr = { "الأحد", "الإثنين", "الثلاثاء", "الأربعاء", "الخميس", "الجمعة", "السبت" };

    int openDays = hoursList.Count(h => !h.IsClosed);
    int closedDays = hoursList.Count(h => h.IsClosed);
}

<style>
    .wh-page { max-width: 900px; margin: 0 auto; }

    .wh-header {
        background: linear-gradient(135deg, #1a1f2e 0%, #243447 100%);
        border-radius: 16px;
        padding: 2rem;
        color: white;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
    }
    .wh-header::before {
        content: '';
        position: absolute;
        top: -40px; right: -40px;
        width: 180px; height: 180px;
        background: rgba(255,165,0,0.08);
        border-radius: 50%;
    }
    .badge-active {
        background: rgba(34,197,94,0.15);
        color: #22c55e;
        border: 1px solid rgba(34,197,94,0.3);
        font-size: 0.75rem;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-weight: 600;
    }
    .badge-center {
        background: rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.7);
        font-size: 0.75rem;
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.15);
    }
    .summary-bar {
        background: linear-gradient(135deg, rgba(249,115,22,0.06), rgba(59,130,246,0.06));
        border: 1px solid rgba(249,115,22,0.2);
        border-radius: 12px;
        padding: 1rem 1.5rem;
        margin-bottom: 1.5rem;
    }
    .day-card {
        background: var(--bs-body-bg, #fff);
        border: 1px solid var(--bs-border-color, #dee2e6);
        border-radius: 12px;
        padding: 1.2rem 1.5rem;
        margin-bottom: 0.75rem;
        transition: all 0.2s ease;
        opacity: 0;
        transform: translateY(10px);
    }
    .day-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-1px) !important; }
    .day-card.is-closed { opacity: 0.65 !important; background: var(--bs-secondary-bg, #f8f9fa); }

    .day-icon {
        width: 42px; height: 42px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .day-icon.weekday { background: rgba(59,130,246,0.12); color: #3b82f6; }
    .day-icon.friday  { background: rgba(34,197,94,0.12);  color: #22c55e; }
    .day-icon.weekend { background: rgba(249,115,22,0.12); color: #f97316; }

    .time-input {
        border-radius: 8px !important;
        border: 1px solid var(--bs-border-color, #ced4da) !important;
        padding: 0.5rem 0.75rem;
        font-size: 0.95rem;
        transition: border-color 0.2s, box-shadow 0.2s;
        min-width: 130px;
    }
    .time-input:focus {
        border-color: #f97316 !important;
        box-shadow: 0 0 0 3px rgba(249,115,22,0.15) !important;
    }
    .time-input:disabled { opacity: 0.35; }

    .closed-toggle { width: 44px; height: 24px; position: relative; cursor: pointer; display: inline-block; }
    .closed-toggle input { opacity: 0; width: 0; height: 0; position: absolute; }
    .slider { position: absolute; inset: 0; background: #ccc; border-radius: 24px; transition: 0.3s; }
    .slider:before {
        content: ''; position: absolute;
        height: 18px; width: 18px; left: 3px; bottom: 3px;
        background: white; border-radius: 50%; transition: 0.3s;
    }
    .closed-toggle input:checked + .slider { background: #ef4444; }
    .closed-toggle input:checked + .slider:before { transform: translateX(20px); }

    .tip-box {
        background: rgba(59,130,246,0.06);
        border-left: 3px solid #3b82f6;
        border-radius: 0 8px 8px 0;
        padding: 0.75rem 1rem;
        font-size: 0.85rem;
        color: var(--bs-secondary-color, #6c757d);
        margin-bottom: 1.5rem;
    }
    .btn-save {
        background: linear-gradient(135deg, #f97316, #ea580c);
        border: none; border-radius: 10px;
        padding: 0.7rem 2rem; font-weight: 600; color: white;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(249,115,22,0.3);
    }
    .btn-save:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(249,115,22,0.4); color: white; }
    .btn-action { border-radius: 10px; font-weight: 500; padding: 0.6rem 1.2rem; }
    .duration-bar {
        margin-top: 0.65rem;
        padding-top: 0.65rem;
        border-top: 1px solid var(--bs-border-color, #dee2e6);
        font-size: 0.82rem;
        color: var(--bs-secondary-color, #6c757d);
    }

    @@media (max-width: 576px) {
        .day-card .row > div { margin-bottom: 0.4rem; }
        .time-input { min-width: unset; width: 100%; }
    }
</style>

<div class="wh-page">

    @* ── Header ── *@
    <div class="wh-header">
        <div class="d-flex align-items-center gap-3 mb-3" style="position:relative;z-index:1">
            <div style="background:rgba(249,115,22,0.2);border-radius:12px;width:52px;height:52px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;">
                <i class="bi bi-clock-history text-warning"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold">Working Hours Management</h4>
                <p class="mb-0 small" style="color:rgba(255,255,255,0.6)">
                    FR-34 · Set your center's opening &amp; closing times for each day of the week
                </p>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap" style="position:relative;z-index:1">
            <span class="badge-active"><i class="bi bi-check-circle me-1"></i>Active Schedule</span>
            <span class="badge-center"><i class="bi bi-geo-alt me-1"></i>Center #@centerId</span>
        </div>
    </div>

    @* ── Alerts ── *@
    @if (TempData["Success"] != null)
    {
        <div class="alert border-0 rounded-3 d-flex align-items-center gap-2 mb-3"
             style="background:rgba(34,197,94,0.1);color:#16a34a;border-left:4px solid #22c55e!important">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert border-0 rounded-3 d-flex align-items-center gap-2 mb-3"
             style="background:rgba(239,68,68,0.1);color:#dc2626;border-left:4px solid #ef4444!important">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    @* ── Summary bar ── *@
    <div class="summary-bar d-flex flex-wrap align-items-center gap-4">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-calendar-check text-success fs-5"></i>
            <span>
                <strong>@openDays</strong>
                <span class="text-muted ms-1" style="font-size:.85rem">open days</span>
            </span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-calendar-x text-danger fs-5"></i>
            <span>
                <strong>@closedDays</strong>
                <span class="text-muted ms-1" style="font-size:.85rem">closed days</span>
            </span>
        </div>
        <div class="ms-auto d-none d-md-flex align-items-center gap-2 text-muted" style="font-size:.82rem">
            <i class="bi bi-info-circle text-primary"></i>
            Toggle the red switch to mark a day as closed
        </div>
    </div>

    @* ── Form ── *@
    <form asp-action="WorkingHours" asp-route-id="@centerId" method="post">
        @Html.AntiForgeryToken()

        <div id="daysList">
            @for (int i = 0; i < hoursList.Count; i++)
            {
                var day = hoursList[i];
                int dayIdx = (int)day.DayOfWeek;
                bool isFriday = day.DayOfWeek == DayOfWeek.Friday;
                bool isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                string iconCss = isFriday ? "friday" : (isWeekend ? "weekend" : "weekday");
                string iconClass = isFriday ? "bi-moon-stars" : (isWeekend ? "bi-sun" : "bi-briefcase");

                var duration = day.CloseTime - day.OpenTime;
                string durationText = duration.TotalHours > 0
                    ? $"{(int)duration.TotalHours}h{(duration.Minutes > 0 ? " " + duration.Minutes + "m" : "")}"
                    : "";

                <div class="day-card @(day.IsClosed ? "is-closed" : "")" id="dayCard_@i">

                    @* Hidden inputs *@
                    <input type="hidden" name="[@i].Id"              value="@day.Id" />
                    <input type="hidden" name="[@i].ServiceCenterId" value="@day.ServiceCenterId" />
                    <input type="hidden" name="[@i].DayOfWeek"       value="@((int)day.DayOfWeek)" />

                    <div class="row align-items-center g-3">

                        @* Day label *@
                        <div class="col-12 col-sm-3 d-flex align-items-center gap-3">
                            <div class="day-icon @iconCss">
                                <i class="bi @iconClass"></i>
                            </div>
                            <div>
                                <div class="fw-semibold">@dayNames[dayIdx]</div>
                                <div class="text-muted small">@dayNamesAr[dayIdx]</div>
                            </div>
                        </div>

                        @* Opens *@
                        <div class="col-6 col-sm-3">
                            <label class="form-label text-muted small mb-1">
                                <i class="bi bi-sunrise me-1"></i>Opens
                            </label>
                            <input type="time"
                                   name="[@i].OpenTime"
                                   value="@day.OpenTime.ToString(@"hh\:mm")"
                                   class="form-control time-input"
                                   id="open_@i"
                                   @(day.IsClosed ? "disabled" : "") />
                        </div>

                        @* Closes *@
                        <div class="col-6 col-sm-3">
                            <label class="form-label text-muted small mb-1">
                                <i class="bi bi-sunset me-1"></i>Closes
                            </label>
                            <input type="time"
                                   name="[@i].CloseTime"
                                   value="@day.CloseTime.ToString(@"hh\:mm")"
                                   class="form-control time-input"
                                   id="close_@i"
                                   @(day.IsClosed ? "disabled" : "") />
                        </div>

                        @* Closed toggle *@
                        <div class="col-12 col-sm-3 d-flex align-items-center justify-content-sm-end gap-2">
                            <span class="text-muted small" id="closedLabel_@i">
                                @(day.IsClosed ? "Closed" : "Open")
                            </span>
                            <label class="closed-toggle" title="Mark day as closed">
                                <input type="checkbox"
                                       name="[@i].IsClosed"
                                       value="true"
                                       id="closed_@i"
                                       @(day.IsClosed ? "checked" : "")
                                       onchange="toggleDay(@i)" />
                                <span class="slider"></span>
                            </label>
                        </div>

                    </div>

                    @* Duration hint *@
                    @if (!day.IsClosed && duration.TotalHours > 0)
                    {
                        <div class="duration-bar d-flex align-items-center gap-2">
                            <i class="bi bi-hourglass-split text-warning"></i>
                            <span>Open for <strong>@durationText</strong> on this day</span>
                        </div>
                    }

                </div>
            }
        </div>

        @* Tip *@
        <div class="tip-box">
            <i class="bi bi-lightbulb text-primary me-1"></i>
            <strong>Tip:</strong> Customers can only book appointments during your listed open hours
            (SRS <strong>FR-32</strong>, <strong>FR-33</strong>, <strong>FR-34</strong>).
        </div>

        @* Action buttons *@
        <div class="d-flex flex-wrap align-items-center gap-2 justify-content-between">
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-action">
                <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
            </a>
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-outline-danger btn-action" onclick="markAllClosed()">
                    <i class="bi bi-door-closed me-1"></i>Mark All Closed
                </button>
                <button type="button" class="btn btn-outline-success btn-action" onclick="markAllOpen()">
                    <i class="bi bi-door-open me-1"></i>Open All Days
                </button>
                <button type="submit" class="btn btn-save">
                    <i class="bi bi-floppy me-1"></i>Save Working Hours
                </button>
            </div>
        </div>

    </form>
</div>

<script>
    function toggleDay(i) {
        var cb = document.getElementById('closed_' + i);
        var card = document.getElementById('dayCard_' + i);
        var openIn = document.getElementById('open_' + i);
        var closeIn = document.getElementById('close_' + i);
        var label = document.getElementById('closedLabel_' + i);

        if (cb.checked) {
            card.classList.add('is-closed');
            openIn.disabled = true;
            closeIn.disabled = true;
            label.textContent = 'Closed';
        } else {
            card.classList.remove('is-closed');
            openIn.disabled = false;
            closeIn.disabled = false;
            label.textContent = 'Open';
        }
    }

    function markAllClosed() {
        for (var i = 0; i < @hoursList.Count; i++) {
            var cb = document.getElementById('closed_' + i);
            if (cb && !cb.checked) { cb.checked = true; toggleDay(i); }
        }
    }

    function markAllOpen() {
        for (var i = 0; i < @hoursList.Count; i++) {
            var cb = document.getElementById('closed_' + i);
            if (cb && cb.checked) { cb.checked = false; toggleDay(i); }
        }
    }

    // Staggered entrance animation
    document.querySelectorAll('.day-card').forEach(function(card, i) {
        setTimeout(function() {
            card.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
        }, i * 60);
    });
</script>