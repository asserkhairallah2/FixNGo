@model FixNGo.Web.Models.BookingsDashboardViewModel
@{
    ViewData["Title"] = "Bookings Dashboard";
}

<div class="container py-3">
    <!-- Breadcrumb and Top Navigation -->
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <a asp-controller="ServiceCenters" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-2">
            <i class="bi bi-arrow-left me-1"></i>Back to Centers
        </a>
        <a asp-controller="ServiceCenters" asp-action="Index" class="btn btn-primary btn-sm rounded-2">
            <i class="bi bi-plus-circle me-1"></i>New Booking
        </a>
    </div>

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-calendar-check-fill text-primary me-2"></i>Bookings Dashboard
            </h2>
            <p class="text-muted mb-0">
                <i class="bi bi-buildings me-1"></i>@Model.CenterName
            </p>
        </div>
        <div class="text-muted small">
            <i class="bi bi-clock-history me-1"></i>Real-time Appointments Queue
        </div>
    </div>

    <!-- Success / Error Message Notification -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4 rounded-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill fs-4 me-2 text-success"></i>
                <div>
                    <strong>Success!</strong> @TempData["Success"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4 rounded-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-2 text-danger"></i>
                <div>
                    <strong>Error!</strong> @TempData["Error"]
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Counters Grid -->
    <div class="row g-3 mb-4">
        <!-- Pending Bookings Counter -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="p-3 bg-warning-subtle text-warning rounded-3 me-3 fs-3">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Pending Requests</span>
                        <h3 class="fw-bold text-warning mb-0">@Model.PendingCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Accepted Bookings Counter -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="p-3 bg-success-subtle text-success rounded-3 me-3 fs-3">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Accepted Bookings</span>
                        <h3 class="fw-bold text-success mb-0">@Model.AcceptedCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rejected Bookings Counter -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="p-3 bg-danger-subtle text-danger rounded-3 me-3 fs-3">
                        <i class="bi bi-x-circle"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Rejected Bookings</span>
                        <h3 class="fw-bold text-danger mb-0">@Model.RejectedCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Bookings Counter -->
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body p-3 d-flex align-items-center">
                    <div class="p-3 bg-primary-subtle text-primary rounded-3 me-3 fs-3">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Total Bookings</span>
                        <h3 class="fw-bold text-primary mb-0">@Model.TotalCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Tabs & Search Bar -->
    <div class="card shadow-sm border-0 rounded-3 mb-5 mt-4">
        <div class="card-header bg-body border-bottom pt-3 pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <ul class="nav nav-tabs card-header-tabs border-0" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(!Model.CurrentStatus.HasValue ? "active fw-semibold" : "text-secondary")" 
                       asp-action="Dashboard" asp-route-status="" asp-route-search="@Model.CurrentSearch">
                        <i class="bi bi-list-ul me-1"></i>All Bookings
                        <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.CurrentStatus == FixNGo.Domain.Enums.BookingStatus.Pending ? "active fw-semibold text-warning" : "text-secondary")" 
                       asp-action="Dashboard" asp-route-status="@FixNGo.Domain.Enums.BookingStatus.Pending" asp-route-search="@Model.CurrentSearch">
                        <i class="bi bi-hourglass-split me-1"></i>Pending
                        <span class="badge bg-warning text-dark ms-1">@Model.PendingCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.CurrentStatus == FixNGo.Domain.Enums.BookingStatus.Confirmed ? "active fw-semibold text-success" : "text-secondary")" 
                       asp-action="Dashboard" asp-route-status="@FixNGo.Domain.Enums.BookingStatus.Confirmed" asp-route-search="@Model.CurrentSearch">
                        <i class="bi bi-check-circle me-1"></i>Confirmed / Active
                        <span class="badge bg-success ms-1">@Model.AcceptedCount</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(Model.CurrentStatus == FixNGo.Domain.Enums.BookingStatus.Rejected ? "active fw-semibold text-danger" : "text-secondary")" 
                       asp-action="Dashboard" asp-route-status="@FixNGo.Domain.Enums.BookingStatus.Rejected" asp-route-search="@Model.CurrentSearch">
                        <i class="bi bi-x-circle me-1"></i>Rejected / Cancelled
                        <span class="badge bg-danger ms-1">@Model.RejectedCount</span>
                    </a>
                </li>
            </ul>

            <form asp-action="Dashboard" method="get" class="d-flex align-items-center gap-1">
                @if (Model.CurrentStatus.HasValue)
                {
                    <input type="hidden" name="status" value="@Model.CurrentStatus.Value" />
                }
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Search customer, service..." value="@Model.CurrentSearch" />
                    <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                    @if (!string.IsNullOrEmpty(Model.CurrentSearch))
                    {
                        <a asp-action="Dashboard" asp-route-status="@Model.CurrentStatus" class="btn btn-outline-danger" title="Clear search"><i class="bi bi-x"></i></a>
                    }
                </div>
            </form>
        </div>

        <!-- Bookings Table -->
        <div class="card-body p-0">
            @if (!Model.Bookings.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    <h5>No bookings found matching your criteria.</h5>
                    <p class="small">Try clearing your filters or create a new booking.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width: 25%;">Customer & Center</th>
                                <th scope="col" style="width: 22%;">Service & Notes</th>
                                <th scope="col" style="width: 15%;">Appointment Date</th>
                                <th scope="col" style="width: 13%;">Appointment Time</th>
                                <th scope="col" style="width: 10%;">Status</th>
                                <th scope="col" class="text-end" style="width: 15%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.Bookings)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="p-2 bg-body-tertiary rounded-circle me-2 text-primary fs-5">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <div>
                                                <span class="fw-semibold d-block text-body">@booking.CustomerName</span>
                                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@booking.ServiceCenterName</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi bi-wrench me-2 text-secondary"></i>
                                            <div>
                                                <span class="fw-semibold">@booking.ServiceName</span>
                                                <small class="text-muted d-block">@booking.Price.ToString("N0") EGP</small>
                                                @if (!string.IsNullOrEmpty(booking.Notes))
                                                {
                                                    <small class="text-secondary fst-italic">"@booking.Notes"</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="small fw-semibold">@booking.AppointmentDate</span>
                                    </td>
                                    <td>
                                        <span class="small text-muted">
                                            <i class="bi bi-clock me-1"></i>@booking.AppointmentTime
                                        </span>
                                    </td>
                                    <td>
                                        @switch (booking.RawStatus)
                                        {
                                            case FixNGo.Domain.Enums.BookingStatus.Pending:
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                    <i class="bi bi-hourglass-split me-1"></i>Pending
                                                </span>
                                                break;
                                            case FixNGo.Domain.Enums.BookingStatus.Confirmed:
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                    <i class="bi bi-check-circle me-1"></i>Confirmed
                                                </span>
                                                break;
                                            case FixNGo.Domain.Enums.BookingStatus.Completed:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Completed
                                                </span>
                                                break;
                                            case FixNGo.Domain.Enums.BookingStatus.Rejected:
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                    <i class="bi bi-x-circle-fill me-1"></i>Rejected
                                                </span>
                                                break;
                                            case FixNGo.Domain.Enums.BookingStatus.Cancelled:
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                                    <i class="bi bi-slash-circle me-1"></i>Cancelled
                                                </span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="Dashboard" method="post" class="d-inline-flex gap-1 justify-content-end">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="bookingId" value="@booking.Id" />
                                            @if (booking.RawStatus == FixNGo.Domain.Enums.BookingStatus.Pending)
                                            {
                                                <button type="submit" name="actionType" value="Accept" class="btn btn-sm btn-success rounded-2 shadow-sm" title="Accept Booking">
                                                    <i class="bi bi-check-lg me-1"></i>Accept
                                                </button>
                                                <button type="submit" name="actionType" value="Reject" class="btn btn-sm btn-outline-danger rounded-2 shadow-sm" title="Reject Booking">
                                                    <i class="bi bi-x-lg me-1"></i>Reject
                                                </button>
                                            }
                                            else if (booking.RawStatus == FixNGo.Domain.Enums.BookingStatus.Confirmed)
                                            {
                                                <button type="submit" name="actionType" value="Complete" class="btn btn-sm btn-primary rounded-2 shadow-sm" title="Mark Completed">
                                                    <i class="bi bi-check-all me-1"></i>Complete
                                                </button>
                                                <button type="submit" name="actionType" value="Cancel" class="btn btn-sm btn-outline-secondary rounded-2 shadow-sm" title="Cancel Booking">
                                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">—</span>
                                            }
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-body border-top py-3 d-flex justify-content-between align-items-center">
                        <small class="text-muted">Showing page @Model.PageNumber of @Model.TotalPages (Total: @Model.TotalCount)</small>
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Dashboard" asp-route-status="@Model.CurrentStatus" asp-route-search="@Model.CurrentSearch" asp-route-pageNumber="@(Model.PageNumber - 1)">Previous</a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Dashboard" asp-route-status="@Model.CurrentStatus" asp-route-search="@Model.CurrentSearch" asp-route-pageNumber="@p">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Dashboard" asp-route-status="@Model.CurrentStatus" asp-route-search="@Model.CurrentSearch" asp-route-pageNumber="@(Model.PageNumber + 1)">Next</a>
                            </li>
                        </ul>
                    </div>
                }
            }
        </div>
    </div>
</div>
