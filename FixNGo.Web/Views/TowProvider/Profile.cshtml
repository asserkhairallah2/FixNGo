@model FixNGo.Web.ViewModels.TowProviderProfileViewModel
@{
    ViewData["Title"] = "Tow Truck Profile";
}

<!-- شريط التنقل المشترك -->
<partial name="_TowNav" />

<!-- عنوان الصفحة -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0">
            <i class="bi bi-person-badge me-2" style="color:#fd7e14;"></i>Driver & Tow Truck Profile
        </h3>
        <p class="text-muted m-0">Manage your personal contact details, tow truck specifications, and verification documents.</p>
    </div>
</div>

<div class="row g-4">
    <!-- العمود الأيسر: كارت معلومات السائق والمستندات -->
    <div class="col-lg-4">
        <!-- كارت السائق -->
        <div class="card border-0 shadow-sm text-center p-4 mb-4">
            <div class="mb-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning-subtle text-warning" style="width: 85px; height: 85px;">
                    <i class="bi bi-truck-flatbed fs-1"></i>
                </div>
            </div>
            <h5 class="fw-bold mb-1">@Model.FullName</h5>
            <p class="text-muted small mb-3">@Model.TruckType • @Model.TruckMakeModel</p>

            <div class="mb-3">
                @if (Model.VerificationStatus == "VERIFIED")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        <i class="bi bi-patch-check-fill me-1"></i>VERIFIED PROVIDER
                    </span>
                }
                else
                {
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                        <i class="bi bi-hourglass-split me-1"></i>PENDING REVIEW
                    </span>
                }
            </div>

            <hr class="text-muted my-3" />

            <div class="text-start small">
                <div class="mb-2">
                    <i class="bi bi-geo-alt-fill text-danger me-2"></i><strong>Coverage Zone:</strong> @Model.City
                </div>
                <div class="mb-2">
                    <i class="bi bi-telephone-fill text-success me-2"></i><strong>Phone:</strong> @Model.PhoneNumber
                </div>
                <div>
                    <i class="bi bi-envelope-fill text-primary me-2"></i><strong>Email:</strong> @Model.Email
                </div>
            </div>
        </div>

        <!-- كارت المستندات والترخيص -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent py-3 fw-bold">
                <i class="bi bi-file-earmark-check-fill text-warning me-2"></i>Verification Documents
            </div>
            <div class="card-body p-3">
                <div class="list-group list-group-flush small">
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="list-group-item bg-transparent px-0 py-2 d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@doc.DocumentTitle</div>
                                <small class="text-muted">@doc.FileName (@doc.UploadedAt.ToString("MMM yyyy"))</small>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                @doc.Status
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- العمود الأيمن: فورم تعديل بيانات السائق والونش -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent py-3">
                <h5 class="fw-bold m-0">
                    <i class="bi bi-sliders me-2 text-warning"></i>Update Provider & Truck Details
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()

                    <h6 class="text-uppercase text-muted small fw-bold mb-3">1. Driver Information (بيانات السائق)</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Driver Full Name</label>
                            <input asp-for="FullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Primary Operating Area / City</label>
                            <input asp-for="City" class="form-control" required />
                        </div>
                    </div>

                    <hr class="text-muted my-4" />

                    <h6 class="text-uppercase text-muted small fw-bold mb-3">2. Tow Truck Specifications (مواصفات الونش)</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Tow Truck Type</label>
                            <input asp-for="TruckType" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Truck Make & Model</label>
                            <input asp-for="TruckMakeModel" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">License Plate Number (رقم اللوحة)</label>
                            <input asp-for="TruckPlateNumber" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Max Load Capacity (Tons)</label>
                            <input asp-for="MaxLoadCapacityTons" type="number" step="0.5" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Supported Vehicle Categories</label>
                            <input asp-for="SupportedVehicleTypes" class="form-control" required />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                        <a asp-action="Dashboard" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-warning text-dark fw-bold px-4">
                            <i class="bi bi-check2-circle me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>