@model IEnumerable<FixNGo.Web.ViewModels.TowRequestItemViewModel>
@{
    ViewData["Title"] = "Incoming Tow Requests";
}

<partial name="_TowNav" />

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold m-0"><i class="bi bi-bell-fill me-2" style="color:#fd7e14;"></i>Incoming Tow Requests</h3>
        <p class="text-muted m-0">Review pickup locations, destination garages, vehicle types, and accept or decline dispatches.</p>
    </div>
    <span class="badge bg-secondary-subtle text-body fs-6 px-3 py-2">
        @Model.Count() Available Requests
    </span>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <i class="bi bi-truck-flatbed fs-1 text-muted mb-3 d-block"></i>
            <h5>No Open Tow Requests Right Now</h5>
            <p class="text-muted">Stay online! New roadside towing requests in your coverage area will appear here automatically.</p>
            <a asp-action="Dashboard" class="btn btn-outline-emergency">Back to Dashboard</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm @(item.IsEmergencyP0 ? "border-start border-danger border-4" : "")">
                    <div class="card-body p-4">
                        <div class="row align-items-center g-3">
                            <div class="col-lg-8">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="badge bg-dark">#@item.RequestCode</span>
                                    @if (item.IsEmergencyP0)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>HIGH PRIORITY (P0 Accident)</span>
                                    }
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-truck-flatbed me-1"></i>@item.TowTypeRequired
                                    </span>
                                    <span class="badge @(item.IsVehicleMovable ? "bg-info-subtle text-info" : "bg-secondary-subtle text-secondary")">
                                        @(item.IsVehicleMovable ? "Wheels Roll Freely" : "Non-Movable / Locked Wheels")
                                    </span>
                                </div>

                                <h5 class="fw-bold mb-1">
                                    @item.VehicleMakeModel (@item.VehicleYear) — <span class="text-muted fs-6">Plate: @item.VehiclePlate</span>
                                </h5>
                                <p class="text-danger-emphasis small mb-3">
                                    <i class="bi bi-tools me-1"></i><strong>Reported Issue:</strong> @item.ProblemType
                                </p>

                                <div class="row g-2 small bg-body-tertiary p-3 rounded-3">
                                    <div class="col-md-6">
                                        <div class="text-muted">PICKUP LOCATION (نقطة الاستلام)</div>
                                        <div class="fw-semibold"><i class="bi bi-geo-alt-fill text-success me-1"></i>@item.PickupAddress</div>
                                        <div class="text-muted mt-1">@item.DistanceToPickupKm km away • ETA ~@item.EstimatedEtaMinutes mins</div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="text-muted">DESTINATION (الوجهة)</div>
                                        <div class="fw-semibold"><i class="bi bi-flag-fill text-danger me-1"></i>@item.DestinationAddress</div>
                                        <div class="text-muted mt-1">Towing Distance: @item.TowingDistanceKm km</div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4 text-lg-end border-top border-lg-top-0 pt-3 pt-lg-0">
                                <div class="mb-3">
                                    <span class="text-muted small d-block">Estimated Payout (@item.PaymentMethod)</span>
                                    <span class="display-6 fw-bold text-success">@item.EstimatedPrice <small class="fs-5">EGP</small></span>
                                </div>

                                <div class="d-flex flex-wrap justify-content-lg-end gap-2">
                                    <a asp-action="RequestDetails" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                                        <i class="bi bi-eye me-1"></i>Full Details
                                    </a>

                                    <form asp-action="AcceptRequest" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-emergency fw-bold px-4">
                                            <i class="bi bi-check2-circle me-1"></i>Accept Request
                                        </button>
                                    </form>

                                    <form asp-action="RejectRequest" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-outline-danger">
                                            <i class="bi bi-x-lg"></i> Decline
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}